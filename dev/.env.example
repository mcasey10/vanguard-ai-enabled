# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and never committed — this file is, and must only ever
# contain placeholders.

# Active narration provider (DECISIONS.md D042, D065). Gemini is the default —
# leave unset, or set explicitly:
#   NARRATION_PROVIDER=gemini      (default if unset)
#   NARRATION_PROVIDER=anthropic
#   NARRATION_PROVIDER=groq

# Active what-if interpreter provider (DECISIONS.md D053, D065) — a separate
# setting from NARRATION_PROVIDER so the two features can use different
# providers independently. Gemini is the default here too:
#   WHATIF_PROVIDER=gemini         (default if unset)
#   WHATIF_PROVIDER=anthropic
#   WHATIF_PROVIDER=groq

# Required for the active default provider (Gemini) for both features. Get
# a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional / currently inactive — only read if NARRATION_PROVIDER=anthropic
# or WHATIF_PROVIDER=anthropic. Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-key-here

# Optional / currently inactive — only read if NARRATION_PROVIDER=groq or
# WHATIF_PROVIDER=groq (D065 — available as a third provider, not the
# default). Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-key-here
