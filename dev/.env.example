# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and never committed — this file is, and must only ever
# contain placeholders.

# Active narration provider (DECISIONS.md D042). Gemini is the default —
# leave unset, or set explicitly:
#   NARRATION_PROVIDER=gemini      (default if unset)
#   NARRATION_PROVIDER=anthropic

# Required for the active default provider (Gemini). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional / currently inactive — only read if NARRATION_PROVIDER=anthropic.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-key-here
